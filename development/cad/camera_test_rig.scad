// =====================================================================
// Sanas: испытательная оснастка для FOV-теста (camera test rig)
// Файл: development/cad/camera_test_rig.scad
//
// Статус: proposed. Ни одна деталь не напечатана, не примерена и не
//         проверена на реальном модуле камеры или на реальном поручне.
// Дата:   2026-09-03
// Authority: подчиняется ../../GROUND_TRUTH.md и ../CAMERA_GEOMETRY.md
//
// ---------------------------------------------------------------------
// 0. Зачем эта деталь существует
// ---------------------------------------------------------------------
// Это НЕ продуктовое крепление камеры. Продуктовое крепление проектировать
// рано: угол установки не выбран, а выбрать его без съёмки в реальном
// салоне нельзя (CAMERA_GEOMETRY.md разделы 4-6, GROUND_TRUTH.md 4).
//
// Оснастка закрывает пункт 7.4 CAMERA_GEOMETRY.md: снять одну и ту же
// сцену при наклонах 0, 30, 45 и 60 градусов ИЗ ОДНОЙ ТОЧКИ, чтобы угол
// на снимке был известен, а не восстанавливался по памяти.
//
// Четыре требования, из которых выведена вся геометрия:
//   1. Дискретные фиксированные положения, а не фрикционный шарнир.
//      Штифт в отверстии даёт повторяемый угол, затянутый винт не даёт.
//   2. Ось наклона проходит через входной зрачок объектива, поэтому все
//      четыре снимка сделаны из одной точки.
//   3. Модуль камеры садится в карман по трём базам, поэтому снятие и
//      установка не сдвигают сенсор относительно оснастки.
//   4. Крепление к поручню без сверления и без клея: призма плюс два
//      хомута. Форма призмы не зависит ни от высоты потолка, ни от
//      точного диаметра поручня внутри заданного диапазона.
//
// ---------------------------------------------------------------------
// 1. Чего эта модель НЕ доказывает
// ---------------------------------------------------------------------
// * Размеры платы камеры, положение объектива и вынос входного зрачка
//   взяты как ПРЕДПОЛОЖЕНИЕ. До обмера реального модуля штангенциркулем
//   ни одна посадочная поверхность не считается верной.
// * Диаметр и расположение поручней в автобусе Алматы не измерены.
// * Минимальный радиус изгиба шлейфа CSI не подтверждён даташитом.
// * Фиксаторы дают ПОВТОРЯЕМОСТЬ и известную РАЗНИЦУ между положениями.
//   Абсолютный угол оптической оси к горизонту зависит от того, как висит
//   поручень, и обязан измеряться уклономером по верхней плоскости
//   площадки при каждом кадре.
// * Высота камеры над полом в модели не задаётся вообще. Она измеряется
//   рулеткой на месте и записывается в протокол. Это сделано намеренно:
//   высота потолка в репозитории является предположением.
//
// ---------------------------------------------------------------------
// 2. Экспорт
// ---------------------------------------------------------------------
//   openscad -D 'part="arm"'      -o arm.stl    camera_test_rig.scad
//   openscad -D 'part="fork"'     -o fork.stl   camera_test_rig.scad
//   openscad -D 'part="vblock"'   -o vblock.stl camera_test_rig.scad
//   openscad -D 'part="print"'    -o all.stl    camera_test_rig.scad
//   openscad -D 'part="assembly"' -D preview_tilt_deg=45 -o rig.stl camera_test_rig.scad
//
// Все линейные размеры в миллиметрах, углы в градусах.
// Ни одно число не должно появляться внутри модуля: только в блоке
// параметров ниже.
// =====================================================================

$fn = 64;

// --- Выбор выводимой детали -----------------------------------------
part             = "assembly";   // "arm" | "fork" | "vblock" | "assembly" | "print"
preview_tilt_deg = 45;           // град | какой наклон показать в сборке
layout_gap       = 95;           // мм | разнос деталей в раскладке под печать

// =====================================================================
// 3. ПАРАМЕТРЫ
// Формат: значение; // единица | статус | чем подтвердить
// =====================================================================

// --- 3.1 Оптика. Источник: development/scripts/camera_geometry.py ----
// Эти два угла не участвуют в геометрии детали. Они нужны только для
// автоматической проверки, что материал оснастки не попадает в кадр.
fov_half_long_deg  = 64.0;  // град | ВЫВЕДЕНО из 160 град по диагонали, модель equidistant fisheye | реальный угол даёт калибровка OpenCV fisheye
fov_half_short_deg = 48.1;  // град | ВЫВЕДЕНО, короткая ось сенсора | то же

// --- 3.2 Модуль камеры Waveshare IMX219-160 --------------------------
// ВНИМАНИЕ. Весь блок это ПРЕДПОЛОЖЕНИЕ по типовому форм-фактору камеры
// Raspberry Pi. В GROUND_TRUTH.md механические размеры модуля не
// зафиксированы. Подтверждать: механический чертёж на странице Waveshare
// https://www.waveshare.com/imx219-160-camera.htm плюс штангенциркуль по
// прибытии модуля. Если размер отличается, меняется только этот блок.
cam_pcb_w        = 25.0;  // мм | ПРЕДПОЛОЖЕНИЕ | обмер, длинная сторона платы, ложится вдоль салона
cam_pcb_h        = 24.0;  // мм | ПРЕДПОЛОЖЕНИЕ | обмер
cam_pcb_t        = 1.0;   // мм | ПРЕДПОЛОЖЕНИЕ | обмер толщины платы
cam_hole_dx      = 21.0;  // мм | ПРЕДПОЛОЖЕНИЕ | шаг крепёжных отверстий вдоль длинной стороны
cam_hole_dy      = 12.5;  // мм | ПРЕДПОЛОЖЕНИЕ | шаг вдоль короткой стороны
cam_hole_off_x   = 0.0;   // мм | ПРЕДПОЛОЖЕНИЕ | смещение сетки отверстий от центра платы
cam_hole_off_y   = 0.0;   // мм | ПРЕДПОЛОЖЕНИЕ | то же по короткой оси
cam_back_relief  = 4.0;   // мм | ПРЕДПОЛОЖЕНИЕ | высота компонентов и разъёма FFC с тыльной стороны платы
entrance_pupil_z = 12.0;  // мм | TBD, ПРЕДПОЛОЖЕНИЕ | вынос входного зрачка вперёд от лицевой плоскости платы; уточняется по чертежу объектива или по калибровке

// Ориентация сенсора. Длинная ось сенсора обязана лежать вдоль салона,
// иначе расчёт покрытия в CAMERA_GEOMETRY.md неприменим. В модели длинная
// сторона платы (cam_pcb_w) лежит вдоль оси X, а X это направление вдоль
// салона. ПРЕДПОЛОЖЕНИЕ: длинная ось сенсора параллельна длинной стороне
// платы. Подтверждать первым же кадром: снять лист с разметкой и
// проверить, какая сторона кадра длиннее.

// --- 3.3 Крепёж модуля ------------------------------------------------
cam_boss_hole_d  = 1.7;   // мм | конструктивно | 1.7 под самонарез M2, 3.2 под термовтулку M2; выбрать по фактическому крепежу
cam_boss_d       = 5.0;   // мм | конструктивно
pocket_clear     = 0.25;  // мм | конструктивно | зазор кармана по контуру платы, подбирается по первой печати

// --- 3.4 Площадка камеры ---------------------------------------------
plate_margin     = 7.0;   // мм | конструктивно | поле вокруг платы
plate_floor_t    = 3.0;   // мм | конструктивно | толщина дна кармана
plate_w          = 38.0;  // мм | конструктивно | ширина поворотной детали поперёк салона

// --- 3.5 Шлейф CSI ----------------------------------------------------
csi_bend_r       = 6.0;   // мм | TBD, ПРЕДПОЛОЖЕНИЕ | минимальный радиус изгиба FFC; подтверждать даташитом шлейфа, до тех пор брать наибольший найденный
csi_cable_w      = 17.0;  // мм | ПРЕДПОЛОЖЕНИЕ | ширина 15-контактного шлейфа с шагом 1.0 мм; обмер по факту
csi_slot_h       = 2.5;   // мм | конструктивно | высота окна выхода шлейфа
tie_slot_w       = 4.0;   // мм | конструктивно | паз под стяжку, разгрузка натяжения

// --- 3.6 Механизм наклона ---------------------------------------------
tilt_angles      = [0, 30, 45, 60];  // град | из CAMERA_GEOMETRY.md 7.4 | не менять без изменения того файла
detent_r         = 50.0;  // мм | конструктивно | радиус дуги фиксации, определяет угловой люфт
detent_arm_deg   = 45.0;  // град | конструктивно | вынос штифта назад от оптической оси, чтобы дуга не попадала в кадр
pivot_d          = 5.2;   // мм | конструктивно | проход оси M5
pin_d            = 5.2;   // мм | конструктивно | проход фиксирующего штифта M5
pin_fit_clear    = 0.20;  // мм | ПРЕДПОЛОЖЕНИЕ | суммарный зазор штифт-отверстие после печати; определяет угловой люфт, измеряется на первой печати
pivot_boss_r     = 9.0;   // мм | конструктивно
detent_boss_r    = 8.0;   // мм | конструктивно
lug_t            = 6.0;   // мм | конструктивно | толщина боковой щеки поворотной детали

// --- 3.7 Вилка основания ----------------------------------------------
cheek_t          = 6.0;   // мм | конструктивно | толщина щеки основания
cheek_clear      = 0.4;   // мм | конструктивно | зазор между поворотной деталью и щекой
cheek_boss_r     = 12.0;  // мм | конструктивно
base_t           = 8.0;   // мм | конструктивно | толщина плиты основания
base_gap         = 8.0;   // мм | конструктивно | зазор от верхней точки дуги до плиты основания
label_h          = 5.0;   // мм | конструктивно | высота гравировки угла
label_depth      = 0.8;   // мм | конструктивно

// --- 3.8 Крепление к поручню без сверления ----------------------------
// Призма с углом 90 градусов садится на трубу любого диаметра из
// диапазона ниже без подгонки. Точный диаметр поручня в автобусе Алматы
// НЕ ИЗМЕРЕН, поэтому конструкция намеренно к нему не привязана.
rail_d_min       = 20.0;  // мм | ПРЕДПОЛОЖЕНИЕ диапазона | обмер поручня в реальном автобусе
rail_d_max       = 45.0;  // мм | ПРЕДПОЛОЖЕНИЕ диапазона | то же
vee_angle        = 90.0;  // град | конструктивно | угол раскрытия призмы
vee_margin       = 4.0;   // мм | конструктивно | запас глубины призмы сверх контакта с трубой rail_d_max
vee_flat         = 2.0;   // мм | конструктивно | площадка в вершине призмы, чтобы контакт шёл по граням, а не по вершине
shoulder_w       = 24.0;  // мм | конструктивно | ширина полки по краям призмы, в ней проходят хомут и крепёж
strap_w          = 16.0;  // мм | конструктивно | ширина паза под хомут или стяжку
strap_t          = 4.0;   // мм | конструктивно | толщина паза
lanyard_d        = 5.0;   // мм | конструктивно | отверстие под страховочный трос, обязательно в движущемся салоне
mount_bolt_d     = 4.4;   // мм | конструктивно | проход M4
vblock_rot_deg   = 0;     // град | 0 или 90 | направление поручня заранее не известно, поэтому призма ставится в двух ориентациях

// =====================================================================
// 4. ПРОИЗВОДНЫЕ ВЕЛИЧИНЫ
// Начало координат: входной зрачок объектива, он же ось наклона.
// X вдоль салона (сторона наклона), Y поперёк салона, Z вверх.
// При наклоне 0 оптическая ось смотрит в -Z.
// =====================================================================
plate_len      = cam_pcb_w + 2 * plate_margin;
pocket_w       = cam_pcb_w + pocket_clear;
pocket_h       = cam_pcb_h + pocket_clear;
pocket_depth   = cam_pcb_t + cam_back_relief;
plate_t        = pocket_depth + plate_floor_t;
pcb_front_z    = entrance_pupil_z;                  // лицевая плоскость платы
plate_top_z    = pcb_front_z + plate_t;
former_cx      = -plate_len / 2 - csi_bend_r / 2;   // ось валика перегиба шлейфа
former_cz      = pcb_front_z + cam_pcb_t + csi_bend_r;
lug_y          = plate_w / 2 - lug_t;               // внутренняя граница щеки поворотной детали
fork_gap       = plate_w + 2 * cheek_clear;
cheek_y_in     = fork_gap / 2;
cheek_y_out    = cheek_y_in + cheek_t;
base_bot_z     = detent_r + detent_boss_r + base_gap;
base_top_z     = base_bot_z + base_t;

vee_depth      = rail_d_max / 2 * cos(vee_angle / 2) + vee_margin;
vblock_side    = 2 * (vee_depth + shoulder_w);      // призма квадратная в плане, поэтому поворот на 90 градусов допустим
vblock_h       = base_t + vee_depth;                // высота тела призмы вместе с дном
base_side      = vblock_side;                       // плита основания повторяет призму в плане
strap_x        = vee_depth + shoulder_w * 0.25;     // паз хомута сразу за гранью призмы
strap_exit_z   = (base_t + vee_depth) * 0.30;       // высота выхода паза на боковую грань
bolt_x         = vee_depth + shoulder_w * 0.70;     // крепёж дальше от призмы
mount_pitch    = 2 * bolt_x;                        // квадратная сетка крепежа

tilt_max       = max(tilt_angles);
backlash_deg   = atan(pin_fit_clear / detent_r);    // угловой люфт фиксации
rig_drop       = base_top_z;                        // от зрачка до верхней плоскости плиты основания
pupil_err_shift = 2 * sin(tilt_max / 2);            // сдвиг точки съёмки на 1 мм ошибки в entrance_pupil_z

// --- 4.1 Автопроверки, печатаются в консоль при любом рендере --------
echo(str("[rig] площадка ", plate_len, " x ", plate_w, " мм"));
echo(str("[rig] от зрачка до верхней плоскости плиты основания: ", rig_drop, " мм"));
echo(str("[rig] призма ", vblock_side, " x ", vblock_side, " x ", vblock_h,
         " мм, глубина призмы ", vee_depth, " мм, диапазон поручня ",
         rail_d_min, "-", rail_d_max, " мм"));
echo(str("[rig] угловой люфт фиксатора при зазоре ", pin_fit_clear,
         " мм и радиусе ", detent_r, " мм: ", backlash_deg, " град"));
echo(str("[rig] ошибка entrance_pupil_z в 1 мм сдвигает точку съёмки на ",
         pupil_err_shift, " мм при наклоне ", tilt_max, " град"));
echo(str("[rig] ПРОВЕРКА кадра, щека поворотной детали: материал начинается",
         " на y=", lug_y, " мм, граница кадра на z=-", pivot_boss_r,
         " мм равна ", pivot_boss_r * tan(fov_half_short_deg),
         " мм. Первое должно быть больше."));
echo(str("[rig] ПРОВЕРКА кадра, щека основания: материал начинается на y=",
         cheek_y_in, " мм, граница кадра на z=-", cheek_boss_r, " мм равна ",
         cheek_boss_r * tan(fov_half_short_deg), " мм. Первое должно быть больше."));
echo(str("[rig] ПРОВЕРКА кадра, плита основания: её передний нижний угол на ",
         180 - atan((base_side / 2) / base_bot_z),
         " град от надира, верхняя кромка кадра при наклоне ", tilt_max,
         " град равна ", tilt_max + fov_half_long_deg,
         " град. Первое должно быть больше."));
echo("[rig] Абсолютный угол оптической оси измеряется уклономером по верхней");
echo("[rig] плоскости площадки. Фиксаторы дают только повторяемость.");

// =====================================================================
// 5. ПОВОРОТНАЯ ДЕТАЛЬ
// Площадка камеры, две боковые щеки, бобышка оси и бобышка фиксатора.
// Печатается одной деталью: любой разъём между площадкой и осью наклона
// это лишний источник ухода угла.
// =====================================================================

// Положение бобышки фиксатора в системе координат поворотной детали
function detent_pos() = [-detent_r * sin(detent_arm_deg),
                          detent_r * cos(detent_arm_deg)];

// Положение того же отверстия в неподвижной системе при наклоне t
function detent_world(t) = [detent_r * sin(t - detent_arm_deg),
                            detent_r * cos(t - detent_arm_deg)];

module lug_profile_2d() {
    dp = detent_pos();
    union() {
        hull() {
            circle(r = pivot_boss_r);
            translate(dp) circle(r = detent_boss_r);
        }
        hull() {
            circle(r = pivot_boss_r);
            translate([-plate_len / 2, pcb_front_z]) square([plate_len, plate_t]);
        }
    }
}

module lug_solid(y0, y1) {
    translate([0, y1, 0])
        rotate([90, 0, 0])
            linear_extrude(height = y1 - y0)
                lug_profile_2d();
}

module plate_body() {
    translate([-plate_len / 2, -plate_w / 2, pcb_front_z])
        cube([plate_len, plate_w, plate_t]);
}

module cable_former() {
    // Валик, вокруг которого шлейф разворачивается назад и вверх. Его
    // радиус равен минимальному допустимому радиусу изгиба, поэтому
    // уложенный по детали шлейф физически нельзя согнуть круче.
    // Нижняя образующая валика лежит на уровне выхода шлейфа из кармана,
    // поэтому шлейф выходит горизонтально и касается валика по касательной.
    translate([former_cx, -plate_w / 2, former_cz])
        rotate([-90, 0, 0])
            cylinder(r = csi_bend_r, h = plate_w);
}

module cam_pads() {
    // Четыре площадки свисают с потолка кармана. Плата упирается в них
    // тыльной стороной, поэтому её лицевая плоскость всегда оказывается на
    // одном и том же уровне, а разъём и компоненты уходят в нишу между
    // площадками.
    for (sx = [-1, 1]) for (sy = [-1, 1])
        translate([cam_hole_off_x + sx * cam_hole_dx / 2,
                   cam_hole_off_y + sy * cam_hole_dy / 2,
                   pcb_front_z + cam_pcb_t])
            cylinder(d = cam_boss_d, h = pocket_depth - cam_pcb_t);
}

module pocket_cut() {
    // Карман платы. Потолок кармана и две смежные стенки это базы
    // установки модуля. Повторяемость обеспечивает карман, винты только
    // прижимают.
    translate([-pocket_w / 2, -pocket_h / 2, pcb_front_z - 1])
        cube([pocket_w, pocket_h, pocket_depth + 1]);
}

module arm_holes() {
    // Окно выхода шлейфа в задней стенке кармана. Вырез доходит ровно до
    // точки касания валика и не срезает его рабочую поверхность.
    translate([former_cx, -csi_cable_w / 2, pcb_front_z + cam_pcb_t])
        cube([-former_cx, csi_cable_w, csi_slot_h]);

    // Проход винтов насквозь, чтобы модуль можно было снять снизу
    for (sx = [-1, 1]) for (sy = [-1, 1])
        translate([cam_hole_off_x + sx * cam_hole_dx / 2,
                   cam_hole_off_y + sy * cam_hole_dy / 2,
                   pcb_front_z - 1])
            cylinder(d = cam_boss_hole_d, h = plate_t + 2);

    // Ось наклона
    translate([0, -plate_w, 0]) rotate([-90, 0, 0])
        cylinder(d = pivot_d, h = 2 * plate_w);

    // Отверстие фиксирующего штифта
    translate([detent_pos()[0], -plate_w, detent_pos()[1]]) rotate([-90, 0, 0])
        cylinder(d = pin_d, h = 2 * plate_w);

    // Сквозные пазы под стяжку, разгрузка натяжения шлейфа
    for (sy = [-1, 1])
        translate([-plate_len / 2 + plate_margin / 4,
                   sy * (csi_cable_w / 2 + tie_slot_w) - tie_slot_w / 2,
                   pcb_front_z - 1])
            cube([tie_slot_w, tie_slot_w, plate_t + 2]);
}

module arm() {
    difference() {
        union() {
            difference() {
                union() {
                    plate_body();
                    cable_former();
                    lug_solid(lug_y, plate_w / 2);
                    lug_solid(-plate_w / 2, -lug_y);
                }
                pocket_cut();
            }
            cam_pads();
        }
        arm_holes();
    }
}

// =====================================================================
// 6. ВИЛКА ОСНОВАНИЯ
// Две щеки с дугой фиксированных углов и плита под призму.
// =====================================================================

module cheek_profile_2d() {
    hull() {
        circle(r = cheek_boss_r);
        for (i = [0 : len(tilt_angles) - 1])
            translate(detent_world(tilt_angles[i])) circle(r = detent_boss_r);
        translate([-base_side / 2, base_bot_z - 1]) square([base_side, 2]);
    }
}

module cheek_solid(y0, y1) {
    translate([0, y1, 0])
        rotate([90, 0, 0])
            linear_extrude(height = y1 - y0)
                cheek_profile_2d();
}

module base_plate_body() {
    translate([-base_side / 2, -base_side / 2, base_bot_z])
        cube([base_side, base_side, base_t]);
}

module fork_cuts() {
    // Ось наклона
    translate([0, -base_side, 0]) rotate([-90, 0, 0])
        cylinder(d = pivot_d, h = 2 * base_side);

    // Отверстия фиксированных углов
    for (i = [0 : len(tilt_angles) - 1])
        translate([detent_world(tilt_angles[i])[0], -base_side,
                   detent_world(tilt_angles[i])[1]])
            rotate([-90, 0, 0])
                cylinder(d = pin_d, h = 2 * base_side);

    // Гравировка угла у каждого отверстия на внешней стороне щеки
    for (i = [0 : len(tilt_angles) - 1])
        translate([detent_world(tilt_angles[i])[0], cheek_y_out + 1,
                   detent_world(tilt_angles[i])[1] - detent_boss_r - label_h])
            rotate([90, 0, 0])
                linear_extrude(height = label_depth + 1)
                    text(str(tilt_angles[i]), size = label_h,
                         halign = "center", valign = "bottom");

    // Крепёж призмы, квадратная сетка
    for (sx = [-1, 1]) for (sy = [-1, 1])
        translate([sx * mount_pitch / 2, sy * mount_pitch / 2, base_bot_z - 1])
            cylinder(d = mount_bolt_d, h = base_t + 2);

    // Отверстия страховочного троса по торцам плиты
    for (sx = [-1, 1])
        translate([sx * (base_side / 2 - lanyard_d), 0, base_bot_z - 1])
            cylinder(d = lanyard_d, h = base_t + 2);
}

module fork() {
    difference() {
        union() {
            cheek_solid(cheek_y_in, cheek_y_out);
            cheek_solid(-cheek_y_out, -cheek_y_in);
            base_plate_body();
        }
        fork_cuts();
    }
}

// =====================================================================
// 7. ПРИЗМА ПОД ПОРУЧЕНЬ
// Ось паза идёт вдоль Y. Ни один размер не привязан к конкретному
// диаметру поручня и к высоте потолка.
// =====================================================================

module vee_profile_2d() {
    // Сечение выреза в плоскости XZ: площадка в вершине и две грани
    // под половиной угла раскрытия, выведенные выше уровня детали.
    polygon(points = [
        [-vee_flat / 2, base_t],
        [ vee_flat / 2, base_t],
        [ vee_flat / 2 + vee_depth * tan(vee_angle / 2), base_t + vee_depth],
        [ vblock_side, base_t + vee_depth],
        [ vblock_side, vblock_h + vee_depth],
        [-vblock_side, vblock_h + vee_depth],
        [-vblock_side, base_t + vee_depth],
        [-vee_flat / 2 - vee_depth * tan(vee_angle / 2), base_t + vee_depth]
    ]);
}

module vblock_cuts() {
    // Призматический вырез на всю длину блока
    translate([0, vblock_side / 2 + 1, 0])
        rotate([90, 0, 0])
            linear_extrude(height = vblock_side + 2)
                vee_profile_2d();

    // Пазы под хомут: вход сверху рядом с гранью призмы, выход на боковую
    // грань. Лента идёт вверх, через поручень и вниз, и застёгивается сбоку
    // от призмы. Плита основания при этом не мешает.
    for (sx = [-1, 1])
        hull() {
            translate([sx * strap_x - strap_t / 2, -strap_w / 2, vblock_h - 1])
                cube([strap_t, strap_w, 2]);
            translate([sx * (vblock_side / 2 + 1) - strap_t / 2, -strap_w / 2,
                       strap_exit_z])
                cube([strap_t, strap_w, 2]);
        }

    // Крепёж к плите основания
    for (sx = [-1, 1]) for (sy = [-1, 1])
        translate([sx * mount_pitch / 2, sy * mount_pitch / 2, -1])
            cylinder(d = mount_bolt_d, h = vblock_h + 2);
}

module vblock() {
    difference() {
        translate([-vblock_side / 2, -vblock_side / 2, 0])
            cube([vblock_side, vblock_side, vblock_h]);
        vblock_cuts();
    }
}

// =====================================================================
// 8. СБОРКА И РАСКЛАДКА ПОД ПЕЧАТЬ
// =====================================================================
module assembly(t) {
    rotate([0, t, 0]) arm();
    fork();
    translate([0, 0, base_top_z]) rotate([0, 0, vblock_rot_deg]) vblock();
}

module print_layout() {
    translate([0, -layout_gap, 0]) arm();
    fork();
    translate([0, layout_gap, 0]) vblock();
}

if (part == "arm")         arm();
else if (part == "fork")   fork();
else if (part == "vblock") vblock();
else if (part == "print")  print_layout();
else                       assembly(preview_tilt_deg);

